
pipeline {
    agent any

    tools {
        jdk 'JDK 25'
        maven 'Maven-3.10'
    }

    options {
        timestamps()
    }

    stages {

        stage('Checkout SCM') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('SCM Synchronization') {
            steps {
                echo 'Source code synchronization completed.'
                bat 'git status'
            }
        }

        stage('Static Verification') {
            steps {
                echo 'Checking Maven project layout rules...'

                bat 'where java'
                bat 'java -version'

                bat 'where mvn'
                bat 'mvn -version'

                bat 'mvn validate'
            }
        }

        stage('Compilation') {
            steps {
                echo 'Compiling calculator project...'
                bat 'mvn clean compile'
            }
        }

        stage('Automated Testing') {
            steps {
                echo 'Running JUnit automated tests...'
                bat 'mvn test'
            }
        }

        stage('Recording Test Results') {
            steps {
                echo 'Publishing JUnit test reports...'

                junit(
                    testResults: '**/target/surefire-reports/TEST-*.xml',
                    allowEmptyResults: false
                )
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Calculator project built and tested successfully!'
        }

        failure {
            echo 'FAILED: Please check the Jenkins console output.'
        }

        always {
            echo 'Jenkins pipeline execution completed.'
        }
    }
}
